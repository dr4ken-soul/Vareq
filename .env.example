# Copy values into the ignored local .env or Vercel project settings.
VITE_SITE_URL=http://localhost:5173
VITE_PRIVY_APP_ID=
VITE_ENABLE_AI=false
VITE_ENABLE_TESTNET=false
VITE_BASE_SEPOLIA_SOURCE_VULNERABLE_ADDRESS=
VITE_BASE_SEPOLIA_SOURCE_PATCHED_ADDRESS=

# Public testnet RPC endpoints. The server pins these hosts and verifies EVM chain identity or native runtime identity.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
PORTALDOT_V3_EVM_RPC_URL=https://test-evm-rpc-v3.portaldot.dev
PORTALDOT_V3_NATIVE_WS_URL=wss://test-node-v3.portaldot.dev
PORTALDOT_NATIVE_FIXTURE_PATCHED_ADDRESS=
VITE_PORTALDOT_NATIVE_FIXTURE_PATCHED_ADDRESS=
PORTALDOT_NATIVE_FIXTURE_VULNERABLE_ADDRESS=
VITE_PORTALDOT_NATIVE_FIXTURE_VULNERABLE_ADDRESS=
PORTALDOT_NATIVE_ARTIFACT_PATH=

# Server only. Never add a VITE_ prefix to these values.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional comma-separated same-site origins for a custom deployment.
VAREQ_ALLOWED_ORIGINS=

# Local-only testnet signers. Use three separate, disposable test accounts; never add these keys to Vercel or commit them. The deployer/user and operator need test gas; the attester signs permits and observed-fill receipts.
TESTNET_DEPLOYER_PRIVATE_KEY=
OPERATOR_PRIVATE_KEY=
ATTESTER_PRIVATE_KEY=

# Local-only encrypted Portaldot wallet exports for native Substrate evidence.
# Keep the encrypted JSON files outside this repository and never add these values to Vercel.
PORTALDOT_NATIVE_OPERATOR_KEYSTORE_PATH=
PORTALDOT_NATIVE_OPERATOR_KEYSTORE_PASSWORD=
PORTALDOT_NATIVE_ATTESTER_KEYSTORE_PATH=
PORTALDOT_NATIVE_ATTESTER_KEYSTORE_PASSWORD=
